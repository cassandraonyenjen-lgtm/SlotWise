# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (Neon/Supabase in prod; local docker or Postgres for dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotwise

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — magic-link sign-in. Also used for booking emails unless RESEND_API_KEY is set.
AUTH_RESEND_KEY=
# Booking emails (F4). Without any Resend key, emails are printed to the server log instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM records). Hosts appear as "Name via Slotwise".
EMAIL_FROM="Slotwise <no-reply@example.com>"

# Inngest — background jobs for reminders and email retries.
# Local: run `pnpm dlx inngest-cli@latest dev` and set INNGEST_DEV=1.
# Production: keys from app.inngest.com. Without either, confirmations send inline and
# reminders are skipped.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Secret for manage (reschedule/cancel) links in emails. Defaults to AUTH_SECRET.
# Changing it invalidates links already sent.
MANAGE_LINK_SECRET=

# Public base URL used for booking links
NEXT_PUBLIC_APP_URL=http://localhost:3000
