# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (Neon/Supabase in prod; local docker or Postgres for dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotwise

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — magic-link sign-in. Also used for booking emails unless RESEND_API_KEY is set.
AUTH_RESEND_KEY=
# Booking emails (F4). Without any Resend key, emails are printed to the server log instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM records). Hosts appear as "Name via Slotwise".
EMAIL_FROM="Slotwise <no-reply@example.com>"

# Inngest — background jobs for reminders and email retries.
# Local: run `pnpm dlx inngest-cli@latest dev` and set INNGEST_DEV=1.
# Production: keys from app.inngest.com. Without either, confirmations send inline and
# reminders are skipped.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Secret for manage (reschedule/cancel) links in emails. Defaults to AUTH_SECRET.
# Changing it invalidates links already sent.
MANAGE_LINK_SECRET=

# Public base URL used for booking links. On Vercel it defaults to the project's own address.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Launch hardening (Phase 5). Everything below is optional locally; each feature turns on
# --- only when its keys are set.

# Upstash Redis — rate limits shared across servers. Without it, limits are kept per server
# in memory (fine for local dev, not for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — invisible bot check on the public booking form.
# Keys from dash.cloudflare.com → Turnstile. Without them the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry — error tracking. Manage-link tokens are scrubbed before anything is sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — product analytics (cookieless). Without a key, nothing is tracked.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend webhook signing secret (Resend → Webhooks). Records delivered/bounced/complained
# on email_log. Without it, /api/webhooks/resend returns 404.
RESEND_WEBHOOK_SECRET=

# Shown on the privacy policy and terms as the contact address.
LEGAL_CONTACT_EMAIL=
