# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (Neon/Supabase in prod; local docker or Postgres for dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotwise

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — used for magic-link sign-in now, transactional email in F4
AUTH_RESEND_KEY=
EMAIL_FROM="Slotwise <no-reply@example.com>"

# Public base URL used for booking links
NEXT_PUBLIC_APP_URL=http://localhost:3000
